{
  "name": "exampro-server",
  "version": "1.0.0",
  "description": "ExamPro backend",
  "private": true,
  "type": "module",
  "main": "server.js",
  "author": "HDM",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "admin": "node scripts/admin.js",
    "migrate": "node scripts/migrateToMultiTenant.js",
    "drop-indexes": "node scripts/dropOldIndexes.js",
    "seed-departments": "node scripts/seedDepartments.js",
    "pwa": "node scripts/generate-pwa-assets.js",
    "build": "npm run install:client && npm run pwa && npm run build:client",
    "install:client": "npm --prefix client install --include=dev",
    "build:client": "npm --prefix client run build"
  },
  "dependencies": {
    "express": "^4.21.1",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^7.4.1",
    "mongoose": "^8.8.0",
    "mongodb": "^6.10.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "cloudinary": "^2.5.1",
    "multer-storage-cloudinary": "^4.0.0",
    "pdfkit": "^0.14.0",
    "sharp": "^0.33.5",
    "xlsx": "^0.18.5",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}